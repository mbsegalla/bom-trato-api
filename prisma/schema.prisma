// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BillingInterval {
  MONTH
  YEAR
}

enum AuthActionPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  SESSION_REPLACED
  SESSION_REVOKED
  REFRESH_REUSE
  PASSWORD_RESET
  SESSION_LIMIT
}

enum OrganizationRole {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum CheckoutAttemptStatus {
  PENDING
  COMPLETE
  EXPIRED
}

enum PaymentMethodUpdateStatus {
  PENDING
  APPLIED
  CANCELED
}

enum PlanChangeMode {
  IMMEDIATE
  PERIOD_END
}

enum PlanChangeStatus {
  QUOTED
  PROCESSING
  PENDING_PAYMENT
  SCHEDULED
  APPLIED
  CANCELED
  EXPIRED
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ServiceUnit {
  SERVICE
  HOUR
  DAY
  UNIT
  SQUARE_METER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  CANCELED
}

enum WorkOrderStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum ReceivablePaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

model Plan {
  id                    String    @id @default(uuid()) @db.Uuid
  code                  String    @unique @db.VarChar(50)
  name                  String    @db.VarChar(100)
  description           String?   @db.Text
  stripeProductId       String    @unique
  maxUsers              Int
  teamManagementEnabled Boolean   @default(false)
  displayOrder          Int       @default(0)
  changeLevel           Int       @default(0)
  configVersion         Int       @default(1)
  stripeActive          Boolean   @default(true)
  published             Boolean   @default(false)
  stripeMetadata        Json      @default("{}")
  lastSyncedAt          DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  planPrices PlanPrice[]
}

model PlanPrice {
  id             String          @id @default(uuid()) @db.Uuid
  planId         String          @db.Uuid
  stripePriceId  String          @unique
  lookupKey      String?         @unique
  amountInCents  Int
  currency       String          @db.VarChar(3)
  interval       BillingInterval
  intervalCount  Int             @default(1)
  stripeActive   Boolean         @default(true)
  published      Boolean         @default(false)
  stripeMetadata Json            @default("{}")
  lastSyncedAt   DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  plan              Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourcePlanChanges PlanChange[]      @relation("PlanChangeSource")
  targetPlanChanges PlanChange[]      @relation("PlanChangeTarget")
  checkoutAttempts  CheckoutAttempt[]
  subscriptions     Subscription[]

  @@index([planId])
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(254)
  passwordHash    String
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  disabledAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  organizations       Organization[]       @relation("OrganizationOwner")
  workOrders          WorkOrder[]          @relation("AssignedWorkOrders")
  authSessions        AuthSession[]
  authActionTokens    AuthActionToken[]
  organizationMembers OrganizationMember[]
}

model AuthSession {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @db.Uuid
  lastRefreshedAt   DateTime                 @db.Timestamptz(3)
  idleExpiresAt     DateTime                 @db.Timestamptz(3)
  absoluteExpiresAt DateTime                 @db.Timestamptz(3)
  revokedAt         DateTime?                @db.Timestamptz(3)
  revocationReason  SessionRevocationReason?
  userAgent         String?                  @db.VarChar(300)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, createdAt])
  @@index([absoluteExpiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  authSession AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AuthActionToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  purpose   AuthActionPurpose
  tokenHash String            @unique @db.Char(64)
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  ownerId     String   @db.Uuid
  creationKey String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  owner                            User                              @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  organizationMembers              OrganizationMember[]
  billingCustomer                  BillingCustomer?
  subscriptions                    Subscription[]
  checkoutAttempts                 CheckoutAttempt[]
  billingInvoices                  BillingInvoice[]
  paymentMethodUpdates             PaymentMethodUpdate[]
  planChanges                      PlanChange[]
  organizationInvitations          OrganizationInvitation[]
  organizationInvitationRateLimits OrganizationInvitationRateLimit[]
  customers                        Customer[]
  catalogServices                  CatalogService[]
  quotes                           Quote[]
  workOrders                       WorkOrder[]
  receivables                      Receivable[]

  @@unique([ownerId, creationKey])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
}

model BillingCustomer {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @unique @db.Uuid
  stripeCustomerId    String?   @unique
  billingEmail        String    @db.VarChar(254)
  billingName         String    @db.VarChar(100)
  creationRequestedAt DateTime? @db.Timestamptz(3)
  nextReconcileAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([nextReconcileAt, id])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  planPriceId          String             @db.Uuid
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime           @db.Timestamptz(3)
  currentPeriodEnd     DateTime           @db.Timestamptz(3)
  paidThrough          DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?          @db.Timestamptz(3)
  endedAt              DateTime?          @db.Timestamptz(3)
  stripeCreatedAt      DateTime           @db.Timestamptz(3)
  lastSyncedAt         DateTime           @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planPrice       PlanPrice        @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  billingInvoices BillingInvoice[]

  @@index([organizationId, stripeCreatedAt(sort: Desc), id(sort: Desc)])
}

model CheckoutAttempt {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @db.Uuid
  activeOrganizationId String?               @unique @db.Uuid
  planPriceId          String                @db.Uuid
  stripePriceId        String
  stripeSessionId      String?               @unique
  returnUrl            String                @db.Text
  status               CheckoutAttemptStatus @default(PENDING)
  expiresAt            DateTime              @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planPrice    PlanPrice    @relation(fields: [planPriceId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
}

model BillingInvoice {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  subscriptionId   String    @db.Uuid
  stripeInvoiceId  String    @unique
  number           String?
  status           String    @db.VarChar(30)
  currency         String    @db.VarChar(3)
  amountDue        Int
  amountPaid       Int
  hostedInvoiceUrl String?   @db.Text
  invoicePdf       String?   @db.Text
  paidAt           DateTime? @db.Timestamptz(3)
  stripeCreatedAt  DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, stripeCreatedAt(sort: Desc), id(sort: Desc)])
  @@index([subscriptionId])
}

model BillingMutex {
  key              String   @id @db.VarChar(200)
  token            String   @unique @db.Uuid
  acquiredAt       DateTime @default(now()) @db.Timestamptz(3)
  recoveryRequired Boolean  @default(false)
}

model PaymentMethodUpdate {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @db.Uuid
  activeOrganizationId String?                   @unique @db.Uuid
  requestedById        String                    @db.Uuid
  stripeCustomerId     String
  stripeSubscriptionId String
  stripeSetupIntentId  String?                   @unique
  status               PaymentMethodUpdateStatus @default(PENDING)
  consentVersion       String                    @db.VarChar(50)
  consentAcceptedAt    DateTime                  @db.Timestamptz(3)
  expiresAt            DateTime                  @db.Timestamptz(3)
  nextCheckAt          DateTime                  @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?                 @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, nextCheckAt])
  @@index([organizationId, createdAt])
}

model PlanChange {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  activeOrganizationId String?          @unique @db.Uuid
  requestedById        String           @db.Uuid
  sourcePlanPriceId    String           @db.Uuid
  targetPlanPriceId    String           @db.Uuid
  targetMaxUsers       Int
  stripeCustomerId     String
  stripeSubscriptionId String
  stripeItemId         String
  sourceStripePriceId  String
  targetStripePriceId  String
  mode                 PlanChangeMode
  status               PlanChangeStatus @default(QUOTED)
  currency             String           @db.VarChar(3)
  amountDueNow         Int
  targetAmountInCents  Int
  targetInterval       BillingInterval
  targetIntervalCount  Int
  periodStart          Int
  periodEnd            Int
  prorationDate        Int
  expiresAt            DateTime         @db.Timestamptz(3)
  startedAt            DateTime?        @db.Timestamptz(3)
  stripeInvoiceId      String?
  stripeScheduleId     String?
  nextCheckAt          DateTime         @default(now()) @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourcePlanPrice PlanPrice    @relation("PlanChangeSource", fields: [sourcePlanPriceId], references: [id], onDelete: Restrict)
  targetPlanPrice PlanPrice    @relation("PlanChangeTarget", fields: [targetPlanPriceId], references: [id], onDelete: Restrict)

  @@index([status, nextCheckAt])
  @@index([organizationId, createdAt])
}

model StripeWebhookEvent {
  id               String    @id
  type             String    @db.VarChar(100)
  stripeCustomerId String
  stripeObjectId   String
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @db.Timestamptz(3)
  processedAt      DateTime? @db.Timestamptz(3)
  lastErrorCode    String?   @db.VarChar(100)
  receivedAt       DateTime  @default(now()) @db.Timestamptz(3)
  failedAt         DateTime? @db.Timestamptz(3)
  leaseToken       String?   @db.Uuid
  leaseExpiresAt   DateTime? @db.Timestamptz(3)

  @@index([processedAt, failedAt, nextAttemptAt, id])
}

model OrganizationInvitation {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  email          String                       @db.VarChar(254)
  pendingEmail   String?                      @db.VarChar(254)
  invitedById    String                       @db.Uuid
  tokenHash      String                       @unique @db.Char(64)
  status         OrganizationInvitationStatus @default(PENDING)
  expiresAt      DateTime                     @db.Timestamptz(3)
  lastSentAt     DateTime                     @db.Timestamptz(3)
  acceptedById   String?                      @db.Uuid
  acceptedAt     DateTime?                    @db.Timestamptz(3)
  revokedAt      DateTime?                    @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pendingEmail])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, expiresAt])
}

model OrganizationInvitationRateLimit {
  organizationId String   @id @db.Uuid
  count          Int
  expiresAt      DateTime @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(100)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(30)
  notes          String?   @db.VarChar(5000)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotes       Quote[]
  workOrders   WorkOrder[]
  receivables  Receivable[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, createdAt(sort: Desc), id(sort: Desc)])
}

model CatalogService {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name           String      @db.VarChar(100)
  description    String?     @db.VarChar(2000)
  unit           ServiceUnit @default(SERVICE)
  amountInCents  Int
  currency       String      @default("brl") @db.VarChar(3)
  archivedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quoteItems   QuoteItem[]

  @@index([organizationId, archivedAt, createdAt(sort: Desc), id(sort: Desc)])
}

model Quote {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  customerId      String      @db.Uuid
  customerName    String      @db.VarChar(100)
  customerEmail   String?     @db.VarChar(254)
  customerPhone   String?     @db.VarChar(30)
  title           String      @db.VarChar(150)
  notes           String?     @db.VarChar(5000)
  status          QuoteStatus @default(DRAFT)
  currency        String      @default("brl") @db.VarChar(3)
  discountInCents Int         @default(0)
  subtotalInCents Int         @default(0)
  totalInCents    Int         @default(0)
  version         Int         @default(1)
  validUntil      DateTime?   @db.Timestamptz(3)
  sentAt          DateTime?   @db.Timestamptz(3)
  decidedAt       DateTime?   @db.Timestamptz(3)
  canceledAt      DateTime?   @db.Timestamptz(3)
  createdById     String      @db.Uuid
  updatedById     String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer             Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  quoteItems           QuoteItem[]
  quoteStatusHistories QuoteStatusHistory[]
  workOrders           WorkOrder[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, customerId])
}

model QuoteItem {
  id                    String      @id @default(uuid()) @db.Uuid
  quoteId               String      @db.Uuid
  catalogServiceId      String?     @db.Uuid
  name                  String      @db.VarChar(100)
  description           String?     @db.VarChar(2000)
  unit                  ServiceUnit
  quantityInThousandths Int
  unitAmountInCents     Int
  totalInCents          Int
  position              Int

  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogService CatalogService? @relation(fields: [catalogServiceId], references: [id], onDelete: Restrict)

  @@index([quoteId, position])
  @@index([catalogServiceId])
}

model QuoteStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  quoteId    String       @db.Uuid
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  actorId    String       @db.Uuid
  version    Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, version])
  @@index([quoteId, createdAt, id])
}

model WorkOrder {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  quoteId            String          @unique @db.Uuid
  customerId         String          @db.Uuid
  customerName       String          @db.VarChar(100)
  customerEmail      String?         @db.VarChar(254)
  customerPhone      String?         @db.VarChar(30)
  title              String          @db.VarChar(150)
  instructions       String?         @db.VarChar(5000)
  serviceAddress     String?         @db.VarChar(500)
  executionNotes     String?         @db.VarChar(10000)
  assignedToId       String?         @db.Uuid
  status             WorkOrderStatus @default(OPEN)
  currency           String          @db.VarChar(3)
  subtotalInCents    Int
  discountInCents    Int
  totalInCents       Int
  scheduledStartAt   DateTime?       @db.Timestamptz(3)
  scheduledEndAt     DateTime?       @db.Timestamptz(3)
  startedAt          DateTime?       @db.Timestamptz(3)
  completedAt        DateTime?       @db.Timestamptz(3)
  canceledAt         DateTime?       @db.Timestamptz(3)
  cancellationReason String?         @db.VarChar(1000)
  version            Int             @default(1)
  createdById        String          @db.Uuid
  updatedById        String          @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quote                  Quote                    @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer               Customer                 @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedTo             User?                    @relation("AssignedWorkOrders", fields: [assignedToId], references: [id], onDelete: Restrict)
  workOrderItems         WorkOrderItem[]
  workOrderStatusHistory WorkOrderStatusHistory[]
  receivables            Receivable[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedToId, scheduledStartAt])
}

model WorkOrderItem {
  id                    String      @id @default(uuid()) @db.Uuid
  workOrderId           String      @db.Uuid
  sourceQuoteItemId     String      @db.Uuid
  name                  String      @db.VarChar(100)
  description           String?     @db.VarChar(2000)
  unit                  ServiceUnit
  quantityInThousandths Int
  unitAmountInCents     Int
  totalInCents          Int
  position              Int

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, position])
}

model WorkOrderStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @db.Uuid
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  actorId     String           @db.Uuid
  version     Int
  reason      String?          @db.VarChar(1000)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, version])
  @@index([workOrderId, createdAt, id])
}

model Receivable {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  workOrderId        String           @unique @db.Uuid
  customerId         String           @db.Uuid
  customerName       String           @db.VarChar(100)
  title              String           @db.VarChar(150)
  currency           String           @db.VarChar(3)
  amountInCents      Int
  receivedInCents    Int              @default(0)
  status             ReceivableStatus @default(OPEN)
  dueAt              DateTime         @db.Timestamptz(3)
  notes              String?          @db.VarChar(2000)
  canceledAt         DateTime?        @db.Timestamptz(3)
  canceledById       String?          @db.Uuid
  cancellationReason String?          @db.VarChar(1000)
  version            Int              @default(1)
  createdById        String           @db.Uuid
  updatedById        String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder          WorkOrder           @relation(fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer           Customer            @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  receivablePayments ReceivablePayment[]

  @@index([organizationId, status, dueAt, id])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, customerId])
}

model ReceivablePayment {
  id             String                  @id @default(uuid()) @db.Uuid
  receivableId   String                  @db.Uuid
  requestId      String                  @db.Uuid
  amountInCents  Int
  method         ReceivablePaymentMethod
  receivedAt     DateTime                @db.Timestamptz(3)
  notes          String?                 @db.VarChar(2000)
  recordedById   String                  @db.Uuid
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  reversedAt     DateTime?               @db.Timestamptz(3)
  reversedById   String?                 @db.Uuid
  reversalReason String?                 @db.VarChar(1000)

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  @@unique([receivableId, requestId])
  @@index([receivableId, createdAt(sort: Desc), id(sort: Desc)])
}
